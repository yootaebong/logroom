---
import {
  BUILD_FROM_SOURCE_COMMANDS,
  FEEDBACK_MAILTO,
  GITHUB_CONTRIBUTING_URL,
  GITHUB_ISSUES_URL,
  GITHUB_LICENSE_URL,
  GITHUB_URL,
} from "../consts";
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const links = [
  { href: GITHUB_URL, label: t("openSource.repo") },
  { href: GITHUB_CONTRIBUTING_URL, label: t("openSource.contributing") },
  { href: GITHUB_LICENSE_URL, label: t("openSource.license") },
];
---

<section aria-labelledby="open-source-heading" class="reveal mx-auto max-w-3xl px-6 py-16">
  <h2 id="open-source-heading" class="text-center text-2xl font-semibold text-ink sm:text-3xl">
    {t("openSource.heading")}
  </h2>
  <p class="mx-auto mt-3 max-w-md text-center text-sm text-muted sm:text-base">
    {t("openSource.description")}
  </p>

  <ul class="mt-6 flex flex-wrap justify-center gap-2">
    {
      links.map((link) => (
        <li>
          <a class="oss-pill" href={link.href} rel="noopener">
            {link.label}
          </a>
        </li>
      ))
    }
  </ul>

  <div class="mt-10 rounded-2xl border border-line bg-surface p-6">
    <h3 class="text-sm font-semibold text-ink">{t("openSource.build.heading")}</h3>
    <pre class="oss-code"><code>{BUILD_FROM_SOURCE_COMMANDS.join("\n")}</code></pre>
    <p class="mt-3 text-xs text-muted">{t("openSource.build.note")}</p>
  </div>

  <div class="mt-10 text-center">
    <h3 class="text-sm font-semibold text-ink">{t("openSource.issue.heading")}</h3>
    <p class="mt-3 flex flex-wrap items-center justify-center gap-x-3 gap-y-2 text-sm">
      <a class="oss-pill" href={GITHUB_ISSUES_URL} rel="noopener">{t("openSource.issue.cta")}</a>
      <a class="oss-text-link" href={FEEDBACK_MAILTO}>{t("openSource.issue.mailto")}</a>
    </p>
  </div>
</section>

<style>
  .oss-pill {
    display: inline-flex;
    align-items: center;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 0.45rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-ink);
    text-decoration: none;
    transition: border-color 120ms ease;
  }
  .oss-pill:hover {
    border-color: color-mix(in srgb, var(--color-violet) 50%, var(--color-line));
  }
  .oss-pill:focus-visible,
  .oss-text-link:focus-visible {
    outline: 2px solid var(--color-cyan);
    outline-offset: 2px;
  }
  .oss-text-link {
    font-size: 0.8rem;
    color: var(--color-muted);
    text-decoration: underline;
    text-underline-offset: 3px;
  }
  .oss-text-link:hover {
    color: var(--color-ink);
  }
  .oss-code {
    margin: 0.75rem 0 0;
    overflow-x: auto;
    border-radius: 0.5rem;
    border: 1px solid var(--color-line);
    background: var(--color-canvas);
    padding: 0.75rem 1rem;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    line-height: 1.6;
    color: var(--color-ink);
  }
</style>
