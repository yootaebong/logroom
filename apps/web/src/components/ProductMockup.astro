---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// 실제 앱 스크린샷(public/screens/*.png). 정적 경로로만 참조하므로 파일이 아직 없어도
// 빌드는 통과한다 — 찍어서 넣으면 바로 보인다. 크기는 실제 파일 픽셀 크기와 맞춘다
// (레이아웃 밀림 방지용 width/height).
interface Screen {
  id: "resume" | "digest" | "timeline" | "summary";
  label: string;
  alt: string;
  width: number;
  height: number;
}

const SCREEN_WIDTH = 1440;
const SCREEN_HEIGHT = 900;
const TIMELINE_HEIGHT = 560;

const screens: Screen[] = [
  {
    id: "resume",
    label: t("mockup.tab.resume"),
    alt: t("mockup.alt.resume"),
    width: SCREEN_WIDTH,
    height: SCREEN_HEIGHT,
  },
  {
    id: "digest",
    label: t("mockup.tab.digest"),
    alt: t("mockup.alt.digest"),
    width: SCREEN_WIDTH,
    height: SCREEN_HEIGHT,
  },
  {
    id: "timeline",
    label: t("mockup.tab.timeline"),
    alt: t("mockup.alt.timeline"),
    width: SCREEN_WIDTH,
    height: TIMELINE_HEIGHT,
  },
  {
    id: "summary",
    label: t("mockup.tab.summary"),
    alt: t("mockup.alt.summary"),
    width: SCREEN_WIDTH,
    height: SCREEN_HEIGHT,
  },
];
---

<section aria-labelledby="mockup-heading" class="reveal mx-auto max-w-6xl px-6 py-16">
  <h2 id="mockup-heading" class="sr-only">{t("mockup.heading")}</h2>

  <div class="mac-window">
    <div class="mac-window__titlebar" aria-hidden="true">
      <span class="mac-window__dot mac-window__dot--red"></span>
      <span class="mac-window__dot mac-window__dot--yellow"></span>
      <span class="mac-window__dot mac-window__dot--green"></span>
      <span class="mac-window__title">LogRoom</span>
    </div>

    <div class="mockup-root">
      <div class="mockup-tabbar" role="radiogroup" aria-label={t("mockup.tablist.ariaLabel")}>
        {
          screens.map((screen, index) => (
            <div class="mockup-tab">
              <input
                type="radio"
                name="mockup-tab"
                id={`mockup-tab-${screen.id}`}
                class="mockup-tab__input"
                checked={index === 0}
              />
              <label for={`mockup-tab-${screen.id}`} class="mockup-tab__label">
                {screen.label}
              </label>
            </div>
          ))
        }
      </div>

      {
        screens.map((screen, index) => (
          <div class={`mockup-panel mockup-panel--${screen.id}`}>
            <img
              class="mockup-shot"
              src={`/screens/${screen.id}.png`}
              alt={screen.alt}
              width={screen.width}
              height={screen.height}
              loading={index === 0 ? "eager" : "lazy"}
              fetchpriority={index === 0 ? "high" : "auto"}
              decoding="async"
            />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  /* ---- macOS-style window chrome ---- */
  .mac-window {
    position: relative;
    max-width: 1100px;
    margin-inline: auto;
    border-radius: 1rem;
    border: 1px solid color-mix(in srgb, var(--color-violet) 15%, var(--color-line));
    background: var(--color-surface);
    overflow: hidden;
    box-shadow:
      0 0 0 1px color-mix(in srgb, var(--color-violet) 6%, transparent),
      0 30px 70px -35px color-mix(in srgb, var(--color-violet) 28%, transparent),
      0 30px 70px -45px color-mix(in srgb, var(--color-cyan) 22%, transparent);
  }
  .mac-window__titlebar {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1rem;
    border-bottom: 1px solid var(--color-line);
    background: color-mix(in srgb, var(--color-canvas) 55%, var(--color-surface));
  }
  .mac-window__dot {
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 9999px;
  }
  .mac-window__dot--red {
    background: #ff5f56;
  }
  .mac-window__dot--yellow {
    background: #ffbd2e;
  }
  .mac-window__dot--green {
    background: #27c93f;
  }
  .mac-window__title {
    margin-left: 0.5rem;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
  }

  .mockup-root {
    padding: 1.25rem;
  }
  @media (min-width: 640px) {
    .mockup-root {
      padding: 1.75rem;
    }
  }

  /* ---- CSS-only tabs (Warp-style pill bar, radio-driven, no JS) ---- */
  .mockup-tabbar {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.25rem;
    border-radius: 9999px;
    border: 1px solid var(--color-line);
    background: var(--color-canvas);
    padding: 0.25rem;
    margin-bottom: 1.5rem;
  }
  .mockup-tab {
    position: relative;
  }
  .mockup-tab__input {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0, 0, 0, 0);
    white-space: nowrap;
    border: 0;
  }
  .mockup-tab__label {
    display: inline-flex;
    cursor: pointer;
    border-radius: 9999px;
    padding: 0.45rem 1.1rem;
    font-family: var(--font-mono);
    font-size: 0.75rem;
    color: var(--color-muted);
    transition:
      color 150ms ease,
      background-color 150ms ease,
      box-shadow 150ms ease;
  }
  .mockup-tab:has(.mockup-tab__input:checked) .mockup-tab__label {
    background: var(--color-surface);
    color: var(--color-ink);
    box-shadow: 0 0 0 1px color-mix(in srgb, var(--color-violet) 35%, var(--color-line));
  }
  .mockup-tab__input:focus-visible + .mockup-tab__label {
    outline: 2px solid var(--color-violet);
    outline-offset: 2px;
  }

  .mockup-panel {
    display: none;
  }
  .mockup-root:has(#mockup-tab-resume:checked) .mockup-panel--resume,
  .mockup-root:has(#mockup-tab-digest:checked) .mockup-panel--digest,
  .mockup-root:has(#mockup-tab-timeline:checked) .mockup-panel--timeline,
  .mockup-root:has(#mockup-tab-summary:checked) .mockup-panel--summary {
    display: block;
  }

  .mockup-shot {
    display: block;
    width: 100%;
    height: auto;
    border-radius: 0.6rem;
    border: 1px solid var(--color-line);
    background: var(--color-canvas);
  }
</style>
