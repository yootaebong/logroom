---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

// 5블록: 이어서 하기 → 일·주·월 요약 → 평가서 초안 → 에이전트 경유 분할 → 소스 6개.
// 꾸밈용 가짜 데이터 목업은 두지 않는다 — 실제 화면은 위 ProductMockup 스크린샷이 보여 준다.
const blocks = [
  { title: t("features.resume.title"), description: t("features.resume.description"), wide: true },
  { title: t("features.summary.title"), description: t("features.summary.description") },
  { title: t("features.review.title"), description: t("features.review.description") },
  { title: t("features.agent.title"), description: t("features.agent.description") },
  { title: t("features.connectors.title"), description: t("features.connectors.description") },
];
---

<section aria-labelledby="features-heading" class="reveal mx-auto max-w-5xl px-6 py-16">
  <h2 id="features-heading" class="text-center text-2xl font-semibold text-ink sm:text-3xl">
    {t("features.heading")}
  </h2>

  <div class="mt-10 grid grid-cols-1 gap-4 sm:grid-cols-2">
    {
      blocks.map((block, index) => (
        <article class:list={["bento-tile", { "sm:col-span-2": block.wide }]}>
          <span class="bento-tile__index" aria-hidden="true">
            0{index + 1}
          </span>
          <h3 class="mt-2 text-lg font-semibold text-ink">{block.title}</h3>
          <p class="mt-2 text-sm text-muted">{block.description}</p>
        </article>
      ))
    }
  </div>
</section>

<style>
  .bento-tile {
    position: relative;
    isolation: isolate;
    border-radius: 1rem;
    border: 1px solid var(--color-line);
    background: var(--color-surface);
    padding: 1.5rem;
    transition:
      transform 200ms ease,
      box-shadow 200ms ease;
  }
  .bento-tile:hover,
  .bento-tile:focus-within {
    transform: translateY(-2px);
    box-shadow: 0 16px 40px -20px color-mix(in srgb, var(--color-violet) 55%, transparent);
  }
  .bento-tile__index {
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--color-muted);
  }

  /* Cursor-follow spotlight glow, positioned by --spot-x/--spot-y (see script below). */
  .bento-tile::before {
    content: "";
    position: absolute;
    inset: 0;
    z-index: -1;
    border-radius: inherit;
    background: radial-gradient(
      240px circle at var(--spot-x, 50%) var(--spot-y, 50%),
      color-mix(in srgb, var(--color-violet) 20%, transparent),
      transparent 70%
    );
    opacity: 0;
    transition: opacity 250ms ease;
  }
  .bento-tile:hover::before,
  .bento-tile:focus-within::before {
    opacity: 0.6;
  }

  /* Gradient border ring, revealed on hover/focus via mask-composite trick. */
  .bento-tile::after {
    content: "";
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    padding: 1px;
    background: linear-gradient(135deg, var(--color-violet), var(--color-cyan));
    -webkit-mask:
      linear-gradient(#fff 0 0) content-box,
      linear-gradient(#fff 0 0);
    -webkit-mask-composite: xor;
    mask-composite: exclude;
    opacity: 0;
    pointer-events: none;
    transition: opacity 250ms ease;
  }
  .bento-tile:hover::after,
  .bento-tile:focus-within::after {
    opacity: 1;
  }

  @media (prefers-reduced-motion: reduce) {
    .bento-tile,
    .bento-tile::before,
    .bento-tile::after {
      transition-duration: 0.001ms;
    }
  }
</style>

<script>
  // Cursor-follow spotlight glow on bento tiles — desktop pointers only,
  // rAF-throttled, purely presentational (drives --spot-x/--spot-y).
  if (window.matchMedia("(pointer: fine)").matches) {
    const tiles = document.querySelectorAll<HTMLElement>(".bento-tile");
    let frame = 0;

    for (const tile of tiles) {
      tile.addEventListener("pointermove", (event) => {
        if (frame) return;
        frame = requestAnimationFrame(() => {
          const rect = tile.getBoundingClientRect();
          tile.style.setProperty("--spot-x", `${event.clientX - rect.left}px`);
          tile.style.setProperty("--spot-y", `${event.clientY - rect.top}px`);
          frame = 0;
        });
      });
    }
  }
</script>
