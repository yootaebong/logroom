---
// 설치 마찰의 **선공개** — 공증을 안 하기로 한 이상(비용 대비 검증 우선), 첫 실행 경고는 반드시
// 다운로드 직후에 미리 알려야 한다. 놀라면 이탈하고, 예고하면 넘어온다. 그리고 이 정직함 자체가
// 이 페이지의 프라이버시 포지셔닝과 결이 맞는다.
import { getLangFromUrl, useTranslations } from "../i18n/utils";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const steps = [t("install.step1"), t("install.step2"), t("install.step3")];
---

<section class="border-b border-line bg-surface/40" aria-labelledby="install-heading">
  <div class="mx-auto max-w-2xl px-6 py-12">
    <h2 id="install-heading" class="text-lg font-semibold text-ink">{t("install.heading")}</h2>
    <p class="mt-2 text-sm text-muted">{t("install.description")}</p>

    <ol class="install-steps">
      {steps.map((step) => <li>{step}</li>)}
    </ol>

    <p class="mt-5 rounded-md border border-line px-3 py-2 text-xs text-muted">
      {t("install.updateNote")}
    </p>
    <p class="mt-2 font-mono text-xs text-muted">{t("install.archNote")}</p>
  </div>
</section>

<style>
  .install-steps {
    margin: 1.25rem 0 0;
    padding-left: 1.25rem;
    list-style: decimal;
    display: grid;
    gap: 0.5rem;
    font-size: 0.875rem;
    color: var(--color-ink);
  }
  .install-steps li::marker {
    color: var(--color-muted);
    font-family: var(--font-mono);
    font-size: 0.75rem;
  }
</style>
