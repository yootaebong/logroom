---
import { getLangFromUrl, useTranslations } from "../i18n/utils";

// Waitlist submissions, in priority order:
// 1. Supabase — if both PUBLIC_SUPABASE_URL and PUBLIC_SUPABASE_ANON_KEY are set,
//    the browser posts directly to `${url}/rest/v1/waitlist` with the anon key.
//    See supabase/waitlist.sql for the table + RLS policy this relies on.
// 2. PUBLIC_WAITLIST_ENDPOINT (e.g. a Formspree form URL).
// 3. Neither configured — the CTA falls back to a plain `mailto:` link.
// See README.md for setup of either option.
const supabaseUrl = import.meta.env.PUBLIC_SUPABASE_URL?.trim();
const supabaseAnonKey = import.meta.env.PUBLIC_SUPABASE_ANON_KEY?.trim();
const endpoint = import.meta.env.PUBLIC_WAITLIST_ENDPOINT?.trim();
const mailtoFallback = "mailto:hello@logroom.app?subject=Waitlist";

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);

const useSupabase = Boolean(supabaseUrl && supabaseAnonKey);
const useForm = useSupabase || Boolean(endpoint);
---

<section id="waitlist" aria-labelledby="waitlist-heading" class="mx-auto max-w-md">
  <h2
    id="waitlist-heading"
    class="text-center font-mono text-xs font-semibold uppercase tracking-[0.2em] text-muted"
  >
    {t("waitlist.heading")}
  </h2>
  <p class="mx-auto mt-2 max-w-sm text-center text-sm text-muted">
    {t("waitlist.description")}
  </p>

  {
    useForm ? (
      <form
        id="waitlist-form"
        data-mode={useSupabase ? "supabase" : "endpoint"}
        data-supabase-url={supabaseUrl}
        data-supabase-anon-key={supabaseAnonKey}
        data-endpoint={endpoint}
        data-locale={lang}
        data-msg-submitting={t("waitlist.status.submitting")}
        data-msg-success={t("waitlist.status.success")}
        data-msg-duplicate={t("waitlist.status.duplicate")}
        data-msg-error={t("waitlist.status.error")}
        class="mt-6"
      >
        {/* Honeypot: hidden from real visitors, only bots fill this in. */}
        <div class="hidden" aria-hidden="true">
          <label for="company">Company</label>
          <input type="text" id="company" name="company" tabindex={-1} autocomplete="off" />
        </div>

        <div class="flex flex-col gap-3 sm:flex-row">
          <label for="email" class="sr-only">
            {t("waitlist.emailLabel")}
          </label>
          <input
            type="email"
            id="email"
            name="email"
            required
            placeholder="you@example.com"
            autocomplete="email"
            class="w-full rounded-full border border-line bg-surface px-5 py-3 text-sm text-ink placeholder:text-muted focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet"
          />
          <button
            type="submit"
            class="cta-btn shrink-0 rounded-full bg-gradient-to-r from-violet to-cyan px-6 py-3 text-sm font-semibold text-canvas transition-[filter] duration-200 hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet disabled:cursor-not-allowed disabled:opacity-60"
          >
            {t("waitlist.submit")}
          </button>
        </div>
        <p id="waitlist-status" role="status" aria-live="polite" class="mt-3 min-h-5 text-sm" />
      </form>
    ) : (
      <div class="mt-6 flex justify-center">
        <a
          href={mailtoFallback}
          class="cta-btn inline-flex items-center justify-center rounded-full bg-gradient-to-r from-violet to-cyan px-6 py-3 text-sm font-semibold text-canvas transition-[filter] duration-200 hover:brightness-110 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-violet"
        >
          {t("waitlist.mailtoCta")}
        </a>
      </div>
    )
  }

  {
    useForm && (
      <p class="mx-auto mt-3 max-w-sm text-center text-xs text-muted">
        {t("waitlist.privacyNote")}
      </p>
    )
  }
</section>

<style>
  /* Gradient glow ring behind the CTA button, revealed on hover/focus. */
  .cta-btn {
    position: relative;
    isolation: isolate;
  }
  .cta-btn::before {
    content: "";
    position: absolute;
    inset: -3px;
    z-index: -1;
    border-radius: 9999px;
    background: linear-gradient(90deg, var(--color-cyan), var(--color-violet), var(--color-cyan));
    background-size: 200% 100%;
    opacity: 0;
    filter: blur(5px);
    transition: opacity 200ms ease;
  }
  .cta-btn:hover::before,
  .cta-btn:focus-visible::before {
    opacity: 0.45;
    animation: cta-glow-shift 3s linear infinite;
  }
  @keyframes cta-glow-shift {
    from {
      background-position: 0% 50%;
    }
    to {
      background-position: 200% 50%;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .cta-btn::before {
      transition-duration: 0.001ms;
    }
    .cta-btn:hover::before,
    .cta-btn:focus-visible::before {
      animation: none;
    }
  }
</style>

{
  useForm && (
    <script>
      const form = document.getElementById("waitlist-form");
      const statusEl = document.getElementById("waitlist-status");

      if (form instanceof HTMLFormElement && statusEl) {
        const submitButton = form.querySelector<HTMLButtonElement>('button[type="submit"]');
        const statusMessages = {
          submitting: form.dataset.msgSubmitting ?? "Submitting…",
          success: form.dataset.msgSuccess ?? "Thanks! You're on the list.",
          duplicate: form.dataset.msgDuplicate ?? "You're already on the list.",
          error: form.dataset.msgError ?? "Something went wrong. Please try again.",
        };
        const mode = form.dataset.mode;

        form.addEventListener("submit", async (event) => {
          event.preventDefault();

          const formData = new FormData(form);

          // Honeypot tripped: silently pretend success without submitting.
          if (formData.get("company")) {
            statusEl.textContent = statusMessages.success;
            statusEl.className = "mt-3 min-h-5 text-sm text-trust";
            form.reset();
            return;
          }

          submitButton?.setAttribute("disabled", "true");
          statusEl.textContent = statusMessages.submitting;
          statusEl.className = "mt-3 min-h-5 text-sm text-muted";

          try {
            let response: Response;

            if (mode === "supabase") {
              const supabaseUrl = form.dataset.supabaseUrl;
              const supabaseAnonKey = form.dataset.supabaseAnonKey;
              if (!supabaseUrl || !supabaseAnonKey) {
                throw new Error("Supabase env not configured");
              }

              response = await fetch(`${supabaseUrl}/rest/v1/waitlist`, {
                method: "POST",
                headers: {
                  "Content-Type": "application/json",
                  apikey: supabaseAnonKey,
                  Authorization: `Bearer ${supabaseAnonKey}`,
                  Prefer: "return=minimal",
                },
                body: JSON.stringify({
                  email: formData.get("email"),
                  locale: form.dataset.locale ?? "",
                }),
              });
            } else {
              const endpointUrl = form.dataset.endpoint;
              if (!endpointUrl) {
                throw new Error("Waitlist endpoint not configured");
              }

              response = await fetch(endpointUrl, {
                method: "POST",
                headers: { Accept: "application/json" },
                body: formData,
              });
            }

            if (response.ok) {
              statusEl.textContent = statusMessages.success;
              statusEl.className = "mt-3 min-h-5 text-sm text-trust";
              form.reset();
            } else if (response.status === 409) {
              // Unique constraint violation: already registered — treat as success.
              statusEl.textContent = statusMessages.duplicate;
              statusEl.className = "mt-3 min-h-5 text-sm text-trust";
              form.reset();
            } else {
              statusEl.textContent = statusMessages.error;
              statusEl.className = "mt-3 min-h-5 text-sm text-red-400";
            }
          } catch {
            statusEl.textContent = statusMessages.error;
            statusEl.className = "mt-3 min-h-5 text-sm text-red-400";
          } finally {
            submitButton?.removeAttribute("disabled");
          }
        });
      }
    </script>
  )
}
