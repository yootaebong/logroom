---
import { getAbsoluteLocaleUrl } from "astro:i18n";
import LanguageToggle from "../components/LanguageToggle.astro";
import { GITHUB_LICENSE_URL, GITHUB_URL } from "../consts";
import { defaultLang, languages } from "../i18n/ui";
import { getLangFromUrl, getPathWithoutLocale, useTranslations } from "../i18n/utils";
import "../styles/global.css";

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const canonicalUrl = new URL(Astro.url.pathname, Astro.site).toString();
const siteUrl = new URL("/", Astro.site).toString();
const ogImageUrl = new URL("/og.png", Astro.site).toString();

const lang = getLangFromUrl(Astro.url);
const t = useTranslations(lang);
const pathWithoutLocale = getPathWithoutLocale(Astro.url, lang);
const alternateLocales = Object.keys(languages) as (keyof typeof languages)[];

// BCP 47 / OpenGraph locale codes — only en/ko are supported today.
const OG_LOCALES = { en: "en_US", ko: "ko_KR" } as const;
const ogLocale = OG_LOCALES[lang];
const ogAlternateLocales = alternateLocales.filter((locale) => locale !== lang).map((locale) => OG_LOCALES[locale]);

const siteName = t("site.name");
const keywords = t("meta.keywords");
const ogImageAlt = t("meta.ogImageAlt");

const structuredData = [
  {
    "@context": "https://schema.org",
    "@type": "SoftwareApplication",
    name: siteName,
    url: canonicalUrl,
    description,
    operatingSystem: "macOS",
    applicationCategory: "ProductivityApplication",
    inLanguage: lang,
    license: GITHUB_LICENSE_URL,
    sameAs: [GITHUB_URL],
  },
  {
    "@context": "https://schema.org",
    "@type": "WebSite",
    name: siteName,
    url: siteUrl,
  },
];
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={siteName} />
    <meta name="robots" content="index,follow" />
    <meta name="naver-site-verification" content="b0397296140ca24ad3a9d51ff06cb3f970e3d08a" />
    <meta name="theme-color" content="#08090C" />
    <link rel="canonical" href={canonicalUrl} />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />

    {
      alternateLocales.map((locale) => (
        <link rel="alternate" hreflang={locale} href={getAbsoluteLocaleUrl(locale, pathWithoutLocale)} />
      ))
    }
    <link
      rel="alternate"
      hreflang="x-default"
      href={getAbsoluteLocaleUrl(defaultLang, pathWithoutLocale)}
    />

    <!-- OpenGraph -->
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteName} />
    <meta property="og:url" content={canonicalUrl} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={ogImageAlt} />
    <meta property="og:locale" content={ogLocale} />
    {ogAlternateLocales.map((locale) => <meta property="og:locale:alternate" content={locale} />)}

    <!-- Twitter -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />
    <meta name="twitter:image:alt" content={ogImageAlt} />

    <!-- Structured data (inline — no external request) -->
    {
      structuredData.map((entry) => (
        <script type="application/ld+json" is:inline set:html={JSON.stringify(entry)} />
      ))
    }
  </head>
  <body>
    <LanguageToggle />
    <slot />
  </body>
</html>
