# Supabase project URL and anon public key (Settings > API). If both are set, the
# waitlist form posts directly to Supabase (`${URL}/rest/v1/waitlist`) — see
# supabase/waitlist.sql and README.md for setup. Takes priority over PUBLIC_WAITLIST_ENDPOINT.
PUBLIC_SUPABASE_URL=
PUBLIC_SUPABASE_ANON_KEY=

# Waitlist form submission endpoint (e.g. a Formspree form URL: https://formspree.io/f/xxxxxxx).
# Used only if the Supabase variables above aren't set. If none are set, the waitlist
# CTA falls back to a `mailto:hello@logroom.app` link — see README.md.
PUBLIC_WAITLIST_ENDPOINT=
